# Local dev: copy to .streamlit/secrets.toml and fill in real values (gitignored).
# Streamlit Community Cloud: paste the same keys/values into the app's Settings -> Secrets
# panel instead of committing this file - never commit real credentials.
DB_SERVER = "host,port"
DB_NAME = "database_name"
DB_UID = "username"
DB_PWD = "password"
SECRET_KEY = "change-me-to-a-random-string"
